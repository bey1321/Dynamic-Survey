generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedSurveys    Survey[]             @relation("SurveyOwner")
  createdVersions SurveyVersion[]
  createdShares   SurveyShare[]
  collaborations  SurveyCollaborator[] @relation("CollaboratorUser")
  sentInvitations SurveyCollaborator[] @relation("InvitedBy")

  @@map("users")
}

model Survey {
  id          String       @id @default(uuid())
  ownerId     String       @map("owner_id")
  title       String       @default("Untitled Survey")
  description String?
  status      SurveyStatus @default(DRAFT)
  language    String       @default("en")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owner         User                 @relation("SurveyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions      SurveyVersion[]
  shares        SurveyShare[]
  collaborators SurveyCollaborator[]

  @@map("surveys")
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SurveyVersion {
  id            String   @id @default(uuid())
  surveyId      String   @map("survey_id")
  versionNumber Int      @map("version_number")
  label         String?
  snapshot      Json
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@unique([surveyId, versionNumber])
  @@map("survey_versions")
}

model SurveyShare {
  id         String          @id @default(uuid())
  surveyId   String          @map("survey_id")
  shareToken String          @unique @map("share_token")
  permission SharePermission @default(VIEW)
  createdBy  String          @map("created_by")
  expiresAt  DateTime?       @map("expires_at")
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@map("survey_shares")
}

model SurveyCollaborator {
  surveyId   String          @map("survey_id")
  userId     String          @map("user_id")
  permission SharePermission @default(VIEW)
  invitedBy  String          @map("invited_by")
  createdAt  DateTime        @default(now()) @map("created_at")

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user    User   @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@id([surveyId, userId])
  @@map("survey_collaborators")
}

enum SharePermission {
  VIEW
  EDIT
}
