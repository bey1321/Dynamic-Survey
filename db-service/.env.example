# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/dynamic_survey_db"

# JWT secret — must be a long random string (min 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-secret"

# Port this service runs on (default 5000 — separate from the main app on 4000)
PORT=5000
