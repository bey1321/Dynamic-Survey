generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedSurveys    Survey[]             @relation("SurveyOwner")
  createdVersions SurveyVersion[]
  createdShares   SurveyShare[]
  collaborations  SurveyCollaborator[] @relation("CollaboratorUser")
  sentInvitations SurveyCollaborator[] @relation("InvitedBy")

  @@map("users")
}

// ── Surveys ───────────────────────────────────────────────────────────────────
model Survey {
  id          String       @id @default(uuid())
  ownerId     String       @map("owner_id")
  title       String       @default("Untitled Survey")
  description String?
  status      SurveyStatus @default(DRAFT)
  language    String       @default("en")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owner         User                 @relation("SurveyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions      SurveyVersion[]
  shares        SurveyShare[]
  collaborators SurveyCollaborator[]

  @@map("surveys")
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ── Snapshot Versions ─────────────────────────────────────────────────────────
// Each row is a full point-in-time copy of the entire survey state.
// versionNumber increments per survey: 1, 2, 3 ...
// Nothing is ever overwritten — restoring creates a new row.
model SurveyVersion {
  id            String   @id @default(uuid())
  surveyId      String   @map("survey_id")
  versionNumber Int      @map("version_number")
  label         String?  // optional human label e.g. "After ethics review"
  snapshot      Json     // full survey state: draft, config, variableModel, questions, evalResults
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@unique([surveyId, versionNumber])
  @@map("survey_versions")
}

// ── Share Links ───────────────────────────────────────────────────────────────
// A 64-char random token that grants access without requiring an account.
// Can be VIEW or EDIT, and can optionally expire.
model SurveyShare {
  id         String          @id @default(uuid())
  surveyId   String          @map("survey_id")
  shareToken String          @unique @map("share_token")
  permission SharePermission @default(VIEW)
  createdBy  String          @map("created_by")
  expiresAt  DateTime?       @map("expires_at") // null = never expires
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@map("survey_shares")
}

// ── Collaborators ─────────────────────────────────────────────────────────────
// Direct user-to-user access grants on a specific survey.
model SurveyCollaborator {
  surveyId   String          @map("survey_id")
  userId     String          @map("user_id")
  permission SharePermission @default(VIEW)
  invitedBy  String          @map("invited_by")
  createdAt  DateTime        @default(now()) @map("created_at")

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user    User   @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@id([surveyId, userId])
  @@map("survey_collaborators")
}

enum SharePermission {
  VIEW
  EDIT
}
